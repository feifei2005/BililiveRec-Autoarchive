# 项目特定
# ====================

# 配置文件（保留示例）
config.yaml
*.local.yaml

# 数据库文件
*.db
*.db-journal
*.db-wal
*.db-shm

# 日志文件
*.log
logs/

# 临时文件
tmp/
temp/
*.tmp

# 封面缓存
covers_cache/

