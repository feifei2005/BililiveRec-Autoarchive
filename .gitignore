# ====================
# Go 项目忽略规则
# ====================

# 二进制文件
*.exe
*.exe~
*.dll
*.so
*.dylib

# 测试二进制文件
*.test

# 输出目录
/build/
/dist/
/bin/

# Go 工作区文件
go.work
go.work.sum

# ====================
# IDE 和编辑器
# ====================

# VSCode
.vscode/
*.code-workspace

# JetBrains (GoLand)
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# ====================
# 操作系统
# ====================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

