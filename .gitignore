# ====================

# Node.js
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/.nuxt/

# 构建产物
frontend/wailsjs/

# 环境变量
.env
.env.local
.env.*.local

# ====================
# 依赖管理
# ====================

# Go vendor（如果使用）
# vendor/

# Go sum 备份
go.sum.bak

